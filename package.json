{
  "name": "ludian-attendance",
  "private": true,
  "version": "0.5.5",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 15473 --strictPort",
    "build": "tsc -b && vite build",
    "build:android": "node scripts/build-android.mjs",
    "android:init": "tauri android init",
    "android:build": "tauri android build --apk --target aarch64 --target armv7",
    "preview": "vite preview --host 127.0.0.1 --port 15474",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --no-bundle",
    "release": "npm run desktop:build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1",
    "roster:seed": "node scripts/prepare-roster.mjs",
    "format": "prettier --write src tests scripts *.ts *.json",
    "test:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-native.ps1",
    "lint": "eslint src --max-warnings 0",
    "check:architecture": "node scripts/check-architecture.mjs",
    "format:check": "prettier --check src tests scripts/check-architecture.mjs eslint.config.mjs",
    "check": "npm run lint && npm run check:architecture && npm run format:check && tsc --noEmit",
    "prepare:offline": "node scripts/prepare-offline.mjs",
    "predev": "npm run prepare:offline",
    "prebuild": "npm run prepare:offline"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-fs": "^2.4.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "6.3.289",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tauri-apps/cli": "^2.8.0",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.8",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
